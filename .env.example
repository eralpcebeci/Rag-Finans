# Kopyala: cp .env.example .env
RAG_APP_ENV=dev
RAG_LOG_LEVEL=INFO

RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=kap_reports

# Deney yaparken değiştireceğin alanlar (Faz 2-3'te kullanılacak)
RAG_PARSER=pymupdf
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_LLM_PROVIDER=anthropic
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
